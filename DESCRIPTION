Package: dbMatrix
Title: Database-Backed Matrix Classes and Operations
Version: 0.1.0
Authors@R:
  c(person("Edward", "C. Ruiz", , "ecr7407@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-9174-5387")),
    person("Jiaji", "George Chen", email = "jiajic@bu.edu", role = c("aut")),
